+"""Exact Risley-pair ray trace (vector Snell at all four faces) + beam clearance against solids. Pure maths until the
+clearance step, which uses OCC edges and the bbox branch-and-bound in common.checks.min_dist."""
+import math
+
+def _norm(v): l = math.sqrt(sum(c * c for c in v)); return tuple(c / l for c in v)
+def _dot(a, b): return sum(x * y for x, y in zip(a, b))
+
+def refract(i, n, eta):
+    """i = unit incident direction, n = unit surface normal (either side), eta = n_from / n_to. None on total internal reflection."""
+    if _dot(n, i) > 0: n = tuple(-c for c in n)
+    ci = -_dot(n, i); k = 1 - eta * eta * (1 - ci * ci)
+    if k < 0: return None
+    return _norm(tuple(eta * a + (eta * ci - math.sqrt(k)) * b for a, b in zip(i, n)))
+
+def risley_dir(D, th1, th2):
+    """Beam direction after both wedges. Each wedge: flat entry face normal +z, exit face tilted alpha toward angle th."""
+    a, n = math.radians(D["rp_wedge_deg"]), D["rp_n"]; d = (0.0, 0.0, 1.0)
+    for th in (math.radians(th1), math.radians(th2)):
+        d = refract(d, (0.0, 0.0, 1.0), 1.0 / n)
+        if d is None: return None
+        d = refract(d, (math.sin(a) * math.cos(th), math.sin(a) * math.sin(th), math.cos(a)), n)
+        if d is None: return None
+    return d
+
+def rays(D):
+    """[(th1, th2, start xyz, end xyz on the glow plane, landing radius)] over the sample grid."""
+    x0, y0 = D["las_xy"]; z0 = D["rp_top"]; zt = D["glow_z"]; N = D["rp_samples"]; out = []
+    for i in range(N):
+        for j in range(N):
+            t1, t2 = 360.0 * i / N, 360.0 * j / N
+            d = risley_dir(D, t1, t2)
+            if d is None or d[2] <= 0: out.append((t1, t2, (x0, y0, z0), None, math.inf)); continue
+            s = (zt - z0) / d[2]; e = (x0 + s * d[0], y0 + s * d[1], zt)
+            out.append((t1, t2, (x0, y0, z0), e, math.hypot(e[0], e[1])))
+    return out
+
+def beam_rows(D, parts, row, skip=("Risley", "laser", "glow")):
+    """Rule 5 checks: every sampled ray lands on the glow target, and every beam segment clears every solid."""
+    if not D["optics_on"]: return
+    from build123d import Edge, Vector
+    from ..common.checks import min_dist
+    R = rays(D); r_max = max(r[4] for r in R)
+    row("laser: every ray lands inside the glow target (margin, mm)", D["glow_r"] - r_max, 0.0,
+        f"{len(R)} rays, max landing r {r_max:.2f} vs glow r {D['glow_r']:.2f}; cone {math.degrees(math.atan2(r_max, D['glow_z'] - D['rp_top'])):.1f}° half-angle")
+    # beam as a fat line: distance from the centre line must exceed beam radius (+ divergence over the path) + clearance
+    L = D["glow_z"] - D["rp_top"]; r_beam = D["beam_d"] / 2 + L * D["beam_div_mrad"] * 1e-3 / 2
+    segs = [Edge.make_line(Vector(*s), Vector(*e)) for _, _, s, e, _ in R[:: max(1, len(R) // 96)] if e is not None]
+    obst = [p for n, p in parts.items() if not any(k in n for k in skip)]
+    if obst:
+        row("laser: beam centre line vs any solid (mm)", min_dist(segs, obst) - r_beam, D["beam_clear"],
+            f"{len(segs)} sampled segments vs {len(obst)} parts; beam radius {r_beam:.2f} at the target")
diff -ruN a/knob-param/knobparam/optics/checks.py b/knob-param/knobparam/optics/checks.py
--- a/knob-param/knobparam/optics/checks.py	1970-01-01 08:00:00.000000000 +0800
+++ b/knob-param/knobparam/optics/checks.py	2026-11-01 22:26:42.767318423 +0800
@@ -0,0 +1,17 @@
+"""optics LOCAL checks (own parts + interface values only). Beam vs the whole stack is a CROSS check (assembly/checks.py
+calls optics.beam_rows(D, parts, row) with every part)."""
+import math
+from ..common.checks import Rows
+from .beam import risley_dir
+
+def checks(D, parts):
+    r = Rows("optics"); row = r.row
+    if not D["optics_on"]: return r
+    # no total internal reflection anywhere in the sweep (exact Snell)
+    bad = sum(risley_dir(D, 360 * i / 36, 360 * j / 36) is None for i in range(36) for j in range(36))
+    row("Risley: rays lost to total internal reflection", bad, 0, f"wedge {D['rp_wedge_deg']}°, n {D['rp_n']}", higher_ok=False)
+    row("Risley wedge thin edge vs SLA minimum (mm)", D["rp_t_min"], D["print_wall_min"] * 0.8, "SLA 0.8 per the joystick process table")
+    # alternating ring: emitter-to-emitter gap on the circle
+    V, G = D["vcsel"], D["rgb"]; chord = 2 * D["rl_r"] * math.sin(math.radians(D["rl_pitch_deg"]) / 2)
+    row("ring lights: gap between neighbouring VCSEL and RGB (mm)", chord - (V["y"] + G["y"]) / 2, 0.5, f"{2 * D['rl_n']} emitters on r {D['rl_r']:.2f}")
+    return r
