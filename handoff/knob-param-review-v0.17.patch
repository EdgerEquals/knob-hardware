@@ -0,0 +1,12 @@
+"""optics: 12 VCSELs alternating with 12 RGB LEDs on one circle under the clear race carrier (envelopes only)."""
+import math
+from build123d import *
+
+def build(D):
+    if not D["optics_on"]: return {}
+    out = {}; V, G = D["vcsel"], D["rgb"]; z0 = D["z_glass"] - 60   # [A] placeholder z until IMPORTS bring the carrier z
+    for i in range(2 * D["rl_n"]):
+        a = D["rl_phase_deg"] + i * D["rl_pitch_deg"]; p = V if i % 2 == 0 else G
+        x, y = D["rl_r"] * math.cos(math.radians(a)), D["rl_r"] * math.sin(math.radians(a))
+        out[f"{'VCSEL' if i % 2 == 0 else 'RGB'} {i // 2 + 1}"] = Pos(x, y, z0) * Rot(0, 0, a) * Box(p["x"], p["y"], p["h"], align=(Align.CENTER, Align.CENTER, Align.MIN))
+    return out
diff -ruN a/knob-param/knobparam/optics/parts/scanner.py b/knob-param/knobparam/optics/parts/scanner.py
--- a/knob-param/knobparam/optics/parts/scanner.py	1970-01-01 08:00:00.000000000 +0800
+++ b/knob-param/knobparam/optics/parts/scanner.py	2026-11-01 22:26:42.767061512 +0800
@@ -0,0 +1,19 @@
+"""optics: 405 nm laser body + the two Risley wedges (posed at angle 0; the beam check rotates them mathematically)."""
+import math
+from build123d import *
+from ...common.util import cyl
+
+def wedge(D, z0, rot_deg):
+    """Disc of diameter rp_d, flat bottom at z0, top face tilted by the wedge angle about an axis at rot_deg."""
+    d, a = D["rp_d"], math.radians(D["rp_wedge_deg"])
+    blank = cyl(d / 2, z0, D["rp_t_max"] + 0.01)
+    # cut with a big box tilted by alpha, its bottom face through the thin edge height on one side
+    cut = Pos(0, 0, z0 + D["rp_t_min"] + d / 2 * math.tan(a)) * Rot(0, D["rp_wedge_deg"], 0) * Box(4 * d, 4 * d, 4 * d, align=(Align.CENTER, Align.CENTER, Align.MIN))
+    return Rot(0, 0, rot_deg) * (blank - cut)
+
+def build(D):
+    if not D["optics_on"]: return {}
+    x, y = D["las_xy"]
+    return {"laser 405 nm": Pos(x, y, 0) * cyl(D["las_d"] / 2, D["las_z_ap"] - D["las_len"], D["las_len"]),
+            "Risley wedge 1": Pos(x, y, 0) * wedge(D, D["rp1_z0"], 0.0),
+            "Risley wedge 2": Pos(x, y, 0) * wedge(D, D["rp2_z0"], 180.0)}