  (text "v0.2. Directions at -45 deg: A(1)=UP, B(4)=RIGHT, C(3)=LEFT, D(6)=DOWN, 2=CENTRE, 5=COMMON.\nFrame tabs 7 and 8 and the two M2x11 standoffs are GND. Diagonals = two contacts, read at first-power calibration.\nNo ESD or pull-ups on this board." (exclude_from_sim no) (at 25.4 140 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b03a43fb-472e-411b-8b5c-cba8a25e1722"))
